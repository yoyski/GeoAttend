{
    "name": "geoattend-server",
    "version": "1.0.0",
    "description": "GeoAttend backend: location-based attendance API (Express + MongoDB + TypeScript)",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "dev": "nodemon",
        "build": "tsc",
        "start": "node dist/index.js",
        "migrate:remove-link": "tsx src/scripts/migrate-remove-link.ts",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test src/utils/haversine.test.ts src/utils/hash.test.ts src/utils/csv.test.ts"
    },
    "dependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^20.10.6",
        "@types/node-cron": "^3.0.11",
        "@types/passport": "^1.0.17",
        "@types/passport-google-oauth20": "^2.0.17",
        "bcrypt": "^5.1.1",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.5.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.0",
        "mongoose": "^8.0.0",
        "node-cron": "^4.6.0",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "resend": "^6.37.0",
        "typescript": "^5.3.3",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "nodemon": "^3.1.14",
        "ts-node": "^10.9.2",
        "tsx": "^4.7.0"
    }
}