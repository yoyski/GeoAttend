{
  "name": "geoattend",
  "version": "1.0.0",
  "description": "Location-based attendance tracking application",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yoyski/GeoAttend.git"
  },
  "keywords": [
    "attendance",
    "geolocation",
    "tracking",
    "mern",
    "mongodb",
    "express",
    "react",
    "nodejs"
  ],
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build && cd ../server && npm run build",
    "start": "cd server && npm start",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^8.2.2"
  }
}